APP_NAME=Smart Vending Machine API
DATABASE_URL=postgresql+psycopg://vending:vending@localhost:5432/vending_machine
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Sesuaikan dengan port USB ESP32, misalnya COM3 pada Windows.
# false = simulasi tanpa hardware; true = gunakan ESP32/relay sungguhan.
HARDWARE_ENABLED=false
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT_SECONDS=5

# Kapasitas penuh yang digunakan tombol Restock.
FULL_STOCK=10

# Penyimpanan media iklan dan tutorial.
MEDIA_UPLOAD_DIR=uploads
MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=500
